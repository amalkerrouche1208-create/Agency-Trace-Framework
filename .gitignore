@'
# Python bytecode / caches
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment / secrets
.env
.env.*
!.env.example

# Generated research data
data/processed/
data/analysis/
data/interim/

# Generated outputs
outputs/

# Local historical/reference implementation
legacy/

# Notebook checkpoints
.ipynb_checkpoints/

# Build artifacts
build/
dist/
*.egg-info/

# Archives / backups
*.zip
*.old
'@ | Set-Content .gitignore -Encoding UTF8